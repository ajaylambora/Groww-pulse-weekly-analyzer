# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud > Settings > Secrets.
# Both are optional.

# Without this the app uses the deterministic rules writer.
ANTHROPIC_API_KEY = "paste-your-key-here"

# Keeps your real address out of a public repo and off the public app.
MAIL_TO = "you@yourdomain.com"
